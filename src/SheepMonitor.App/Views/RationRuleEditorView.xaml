<UserControl x:Class="SheepMonitor.App.Views.RationRuleEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="قوانین محاسبه جیره" FontSize="24" FontWeight="Bold" Margin="0,0,0,14"/>
            <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" SelectionChanged="Rule_SelectionChanged" DisplayMemberPath="Name" Height="420"/>
            <Button Content="ذخیره قانون" Click="SaveRule_Click" Margin="0,12,0,0" Padding="12"/>
        </StackPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="تنظیمات قانون" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="نام" Margin="0,14,0,3"/><TextBox Text="{Binding SelectedRule.Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="کد" Margin="0,8,0,3"/><TextBox Text="{Binding SelectedRule.Code, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="کد ماده غذایی" Margin="0,8,0,3"/><TextBox Text="{Binding SelectedRule.FeedCode, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="درصد پایه" Margin="0,8,0,3"/><TextBox Text="{Binding SelectedRule.BasePercent, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="ضریب وزن" Margin="0,8,0,3"/><TextBox Text="{Binding SelectedRule.WeightCoefficient, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="حداقل کیلوگرم" Margin="0,8,0,3"/><TextBox Text="{Binding SelectedRule.MinimumKg, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="حداکثر کیلوگرم" Margin="0,8,0,3"/><TextBox Text="{Binding SelectedRule.MaximumKg, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="درصد پروتئین" Margin="0,8,0,3"/><TextBox Text="{Binding SelectedRule.ProteinPercent, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="انرژی در کیلوگرم" Margin="0,8,0,3"/><TextBox Text="{Binding SelectedRule.EnergyPerKg, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="درصد ماده خشک" Margin="0,8,0,3"/><TextBox Text="{Binding SelectedRule.DryMatterPercent, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="فرمول محاسبه" Margin="0,8,0,3"/><TextBox Text="{Binding SelectedRule.Formula, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70"/>
                <TextBlock Text="درصد وعده‌ها" FontSize="18" FontWeight="Bold" Margin="0,18,0,8"/>
                <DataGrid ItemsSource="{Binding Meals}" AutoGenerateColumns="False" Height="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="وعده" Binding="{Binding MealCode, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="درصد روزانه" Binding="{Binding PercentOfDailyAmount, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="ذخیره وعده انتخاب‌شده" Click="SaveMeal_Click" Margin="0,10,0,20" Padding="12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
