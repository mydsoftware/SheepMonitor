<UserControl x:Class="SheepMonitor.App.Views.ReferenceDataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="مدیریت اطلاعات پایه جیره" FontSize="26" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" Margin="0,16,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="نوع اطلاعات:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CategoryBox" Width="180" SelectedValuePath="Tag" SelectedValue="Feed" SelectionChanged="Category_Changed">
                    <ComboBoxItem Content="مواد غذایی" Tag="Feed"/><ComboBoxItem Content="وعده‌ها" Tag="Meal"/>
                </ComboBox>
                <TextBlock Text="کد:" VerticalAlignment="Center" Margin="20,0,8,0"/><TextBox Width="130" Text="{Binding NewCode, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="عنوان فارسی:" VerticalAlignment="Center" Margin="20,0,8,0"/><TextBox Width="220" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="ترتیب:" VerticalAlignment="Center" Margin="20,0,8,0"/><TextBox Width="70" Text="{Binding NewSortOrder, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="ذخیره" Margin="12,0,0,0" Padding="14,6" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns><DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="160"/><DataGridTextColumn Header="عنوان فارسی" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="ترتیب" Binding="{Binding SortOrder}" Width="100"/><DataGridTemplateColumn Header="عملیات" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="غیرفعال کردن" Click="Disable_Click" Tag="{Binding}" Padding="6,3"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
