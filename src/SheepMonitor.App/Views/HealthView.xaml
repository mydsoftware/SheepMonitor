<UserControl x:Class="SheepMonitor.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="سلامت و بیماری" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="گوسفند:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Sheep}"
                      SelectedItem="{Binding SelectedSheep}"
                      DisplayMemberPath="Number"
                      Width="180"/>
            <Button Content="نمایش سوابق" Margin="10,0,0,0" Padding="14,6" Click="Load_Click"/>
            <Button Content="ثبت بهبودی" Margin="10,0,0,0" Padding="14,6" Click="Recover_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="ثبت سابقه بیماری" Margin="0,0,0,16">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="بیماری"/>
                    <ComboBox ItemsSource="{Binding Diseases}"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Model.DiseaseCode}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="علائم"/>
                    <ComboBox ItemsSource="{Binding Symptoms}"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Model.SymptomsCode}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="شدت"/>
                    <ComboBox ItemsSource="{Binding Severities}"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Model.SeverityCode}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                    <TextBlock Text="تاریخ شروع"/>
                    <DatePicker SelectedDate="{Binding Model.StartedAt}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,12,0,0">
                    <TextBlock Text="توضیحات دامپزشکی"/>
                    <TextBox Text="{Binding Model.VeterinaryNotes, UpdateSourceTrigger=PropertyChanged}"
                             Height="55" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>

                <Button Grid.Row="2" Grid.ColumnSpan="4"
                        Content="ثبت سابقه بیماری"
                        Width="160" HorizontalAlignment="Right"
                        Margin="0,12,0,0" Padding="12,6"
                        Click="Save_Click"/>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Records}"
                  SelectedItem="{Binding SelectedRecord}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="کد بیماری" Binding="{Binding DiseaseCode}" Width="140"/>
                <DataGridTextColumn Header="کد علائم" Binding="{Binding SymptomsCode}" Width="140"/>
                <DataGridTextColumn Header="شدت" Binding="{Binding SeverityCode}" Width="120"/>
                <DataGridTextColumn Header="شروع بیماری" Binding="{Binding StartedAt, StringFormat={}{0:yyyy/MM/dd}}" Width="140"/>
                <DataGridTextColumn Header="بهبودی" Binding="{Binding RecoveredAt, StringFormat={}{0:yyyy/MM/dd}}" Width="140"/>
                <DataGridTextColumn Header="توضیحات" Binding="{Binding VeterinaryNotes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
