<UserControl x:Class="SheepMonitor.App.Views.SheepFeedPlanAssignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="تخصیص برنامه غذایی به گوسفند" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="گوسفند"/><ComboBox ItemsSource="{Binding Sheep}" DisplayMemberPath="Number" SelectedItem="{Binding SelectedSheep}" SelectionChanged="Sheep_SelectionChanged"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="برنامه غذایی"/><ComboBox ItemsSource="{Binding Plans}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPlan}"/></StackPanel>
            <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="شروع"/><DatePicker SelectedDate="{Binding StartDate}"/></StackPanel>
            <StackPanel Grid.Column="3" Margin="10,0,0,0"><TextBlock Text="پایان"/><DatePicker SelectedDate="{Binding EndDate}"/></StackPanel>
            <Button Grid.Column="4" Content="تخصیص برنامه" Margin="10,18,0,0" Padding="14,6" Click="Assign_Click"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="برنامه فعال" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Assignments}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شناسه گوسفند" Binding="{Binding SheepId}" Width="130"/>
                    <DataGridTextColumn Header="شناسه برنامه" Binding="{Binding FeedPlanId}" Width="130"/>
                    <DataGridTextColumn Header="شروع" Binding="{Binding StartDate}" Width="150"/>
                    <DataGridTextColumn Header="پایان" Binding="{Binding EndDate}" Width="150"/>
                    <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsActive}" Width="80"/>
                    <DataGridTextColumn Header="توضیحات" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
