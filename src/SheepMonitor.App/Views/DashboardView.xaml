<UserControl x:Class="SheepMonitor.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Left" Content="به‌روزرسانی" Padding="18,7" Click="Refresh_Click"/>
                <TextBlock Text="داشبورد مدیریتی گله" FontSize="28" FontWeight="Bold"/>
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
                <Border Background="White" CornerRadius="10" Padding="18" Margin="5"><StackPanel><TextBlock Text="تعداد کل گوسفندان"/><TextBlock Text="{Binding TotalSheep}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                <Border Background="White" CornerRadius="10" Padding="18" Margin="5"><StackPanel><TextBlock Text="گوسفندان بیمار"/><TextBlock Text="{Binding SickSheep}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                <Border Background="White" CornerRadius="10" Padding="18" Margin="5"><StackPanel><TextBlock Text="جیره برنامه‌ریزی‌شده (کیلو)"/><TextBlock Text="{Binding PlannedKg, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                <Border Background="White" CornerRadius="10" Padding="18" Margin="5"><StackPanel><TextBlock Text="مصرف خالص (کیلو)"/><TextBlock Text="{Binding NetKg, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="18" Margin="5,0,5,18">
                <StackPanel>
                    <TextBlock Text="روند روزانه مصرف خالص" FontSize="21" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding DailyConsumption}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Height="18" Margin="8,0" Minimum="0" Maximum="1" Value="{Binding BarWidth}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding NetKg, StringFormat={}{0:N2} کیلو}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="خلاصه مصرف خوراک" FontSize="21" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="مصرف واقعی: " FontWeight="Bold"/><TextBlock Text="{Binding ActualKg, StringFormat={}{0:N2}}" Margin="4,0,18,0"/>
                    <TextBlock Text="ضایعات: " FontWeight="Bold"/><TextBlock Text="{Binding WasteKg, StringFormat={}{0:N2}}" Margin="4,0,0,0"/>
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding FeedSummary}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="کد خوراک" Binding="{Binding FeedCode}" Width="*"/>
                        <DataGridTextColumn Header="برنامه (کیلو)" Binding="{Binding PlannedKg, StringFormat={}{0:N2}}" Width="150"/>
                        <DataGridTextColumn Header="مصرف واقعی" Binding="{Binding ActualKg, StringFormat={}{0:N2}}" Width="150"/>
                        <DataGridTextColumn Header="ضایعات" Binding="{Binding WasteKg, StringFormat={}{0:N2}}" Width="130"/>
                        <DataGridTextColumn Header="مصرف خالص" Binding="{Binding NetKg, StringFormat={}{0:N2}}" Width="140"/>
                        <DataGridTextColumn Header="انحراف درصدی" Binding="{Binding DeviationPercent, StringFormat={}{0:N2}%}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
