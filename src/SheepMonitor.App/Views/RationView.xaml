<UserControl x:Class="SheepMonitor.App.Views.RationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
        <TextBlock Text="موتور جیره پویا" FontSize="28" FontWeight="Bold" Margin="0,0,0,14"/>
        <GroupBox Header="قوانین و نحوه محاسبه" Margin="0,0,0,12"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="نام قانون"/><TextBox Text="{Binding RuleModel.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="کد قانون"/><TextBox Text="{Binding RuleModel.Code, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="ماده غذایی"/><ComboBox ItemsSource="{Binding Feeds}" DisplayMemberPath="Title" SelectedValuePath="Code" SelectedValue="{Binding RuleModel.FeedCode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="ضریب وزن"/><TextBox Text="{Binding RuleModel.WeightCoefficient, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Grid.Row="1"><TextBlock Text="درصد پایه"/><TextBox Text="{Binding RuleModel.BasePercent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="حداقل کیلو"/><TextBox Text="{Binding RuleModel.MinimumKg, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="حداکثر کیلو"/><TextBox Text="{Binding RuleModel.MaximumKg, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="درصد پروتئین"/><TextBox Text="{Binding RuleModel.ProteinPercent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Grid.Row="2"><TextBlock Text="انرژی در کیلو"/><TextBox Text="{Binding RuleModel.EnergyPerKg, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="درصد ماده خشک"/><TextBox Text="{Binding RuleModel.DryMatterPercent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"><TextBlock Text="نحوه محاسبه / فرمول"/><TextBox Text="{Binding RuleModel.Formula, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><Button Grid.Row="3" Content="ذخیره قانون" Padding="14,6" Margin="0,10,0,0" Click="SaveRule_Click"/>
        </Grid></GroupBox>
        <GroupBox Header="درصد تقسیم بین وعده‌ها" Margin="0,0,0,12"><StackPanel Margin="12"><ComboBox ItemsSource="{Binding Rules}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedRule}" SelectionChanged="Rule_SelectionChanged"/><DataGrid ItemsSource="{Binding MealRules}" AutoGenerateColumns="False" Height="120" Margin="0,8,0,0"><DataGrid.Columns><DataGridTemplateColumn Header="وعده" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Meals, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Title" SelectedValuePath="Code" SelectedValue="{Binding MealCode, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="درصد از مقدار روزانه" Binding="{Binding PercentOfDailyAmount, UpdateSourceTrigger=PropertyChanged}" Width="220"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="جمع درصد وعده‌ها باید ۱۰۰٪ باشد؛ وعده‌ها از اطلاعات پایه می‌آیند."/><Button Content="ذخیره درصد وعده‌ها" Margin="12,0,0,0" Padding="12,4" Click="SaveMealRules_Click"/></StackPanel></StackPanel></GroupBox>
        <GroupBox Header="دوره جیره و محاسبه"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="نام دوره"/><TextBox Text="{Binding PeriodModel.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="شروع دوره"/><DatePicker SelectedDate="{Binding PeriodStartDate}"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="تعداد روز دوره"/><TextBox Text="{Binding PeriodDurationDays, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><Button Grid.Column="3" Content="ذخیره در اطلاعات پایه" Margin="8,18,0,0" Padding="12,4" Click="SavePeriod_Click"/>
            <StackPanel Grid.Row="1"><TextBlock Text="گوسفند"/><ComboBox ItemsSource="{Binding Sheep}" DisplayMemberPath="Number" SelectedItem="{Binding SelectedSheep}"/></StackPanel><CheckBox Grid.Row="1" Grid.Column="1" Content="تمام گوسفندان با میانگین وزن" Margin="12,20,0,0" IsChecked="{Binding UseAllSheepAverage}"/><StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="وزن دستی (اختیاری)"/><TextBox Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="جیره روز"/><TextBox Text="{Binding DayNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="4" Margin="8,0,0,0"><TextBlock Text="تاریخ شمسی"/><TextBlock Text="{Binding PersianDate}" FontWeight="Bold"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Margin="8,18,0,0"><Button Content="محاسبه روز" Padding="10,4" Click="CalculateDay_Click"/><Button Content="محاسبه دوره" Padding="10,4" Margin="6,0,0,0" Click="CalculatePeriod_Click"/></StackPanel>
        </Grid></GroupBox>
        <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" AutoGenerateColumns="False" Height="180" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="روز" Binding="{Binding DayNumber}" Width="70"/><DataGridTextColumn Header="تاریخ شمسی" Binding="{Binding PersianDate}" Width="120"/><DataGridTextColumn Header="تعداد وعده‌ها" Binding="{Binding Meals.Count}" Width="120"/><DataGridTextColumn Header="مجموع کیلو" Binding="{Binding TotalKg}" Width="120"/></DataGrid.Columns></DataGrid>
        <TextBlock Text="جزئیات جیره روز انتخاب‌شده" FontSize="18" FontWeight="Bold" Margin="0,12,0,6"/><DataGrid ItemsSource="{Binding SelectedResult.Meals}" AutoGenerateColumns="False" Height="180"><DataGrid.Columns><DataGridTextColumn Header="ماده غذایی" Binding="{Binding FeedTitle}" Width="*"/><DataGridTextColumn Header="وعده" Binding="{Binding MealTitle}" Width="160"/><DataGridTextColumn Header="مقدار کیلو" Binding="{Binding AmountKg}" Width="140"/></DataGrid.Columns></DataGrid>
    </StackPanel></ScrollViewer>
</UserControl>
