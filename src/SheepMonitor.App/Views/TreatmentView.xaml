<UserControl x:Class="SheepMonitor.App.Views.TreatmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="درمان بیماری" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="سابقه بیماری:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding HealthRecords}"
                      SelectedValue="{Binding SelectedHealthRecordId}"
                      SelectedValuePath="Id"
                      Width="360">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding DiseaseCode}"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding StartedAt, StringFormat={}{0:yyyy/MM/dd}}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="نمایش درمان‌ها" Margin="10,0,0,0" Padding="14,6" Click="Load_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="ثبت درمان" Margin="0,0,0,14">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="نوع درمان"/>
                    <ComboBox ItemsSource="{Binding TreatmentTypes}"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Model.TreatmentCode}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="دارو"/>
                    <ComboBox ItemsSource="{Binding Medicines}"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Model.MedicineCode}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="دوز"/>
                    <TextBox Text="{Binding Model.Dose, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                    <TextBlock Text="واحد دوز"/>
                    <ComboBox ItemsSource="{Binding DoseUnits}"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Model.DoseUnitCode}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,12,10,0">
                    <TextBlock Text="دفعات در روز"/>
                    <TextBox Text="{Binding Model.DailyFrequency, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,10,0">
                    <TextBlock Text="شروع درمان"/>
                    <DatePicker SelectedDate="{Binding Model.StartedAt}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,10,0">
                    <TextBlock Text="پایان درمان"/>
                    <DatePicker SelectedDate="{Binding Model.EndedAt}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,12,0,0">
                    <TextBlock Text="نتیجه درمان"/>
                    <ComboBox ItemsSource="{Binding TreatmentResults}"
                              DisplayMemberPath="Title"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Model.ResultCode}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <TextBlock Text="توضیحات"/>
                    <TextBox Text="{Binding Model.Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="3"
                        Content="ثبت درمان"
                        Width="130" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,12,0,0" Padding="12,6"
                        Click="Save_Click"/>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Treatments}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="نوع درمان" Binding="{Binding TreatmentCode}" Width="140"/>
                <DataGridTextColumn Header="دارو" Binding="{Binding MedicineCode}" Width="140"/>
                <DataGridTextColumn Header="دوز" Binding="{Binding Dose}" Width="100"/>
                <DataGridTextColumn Header="واحد" Binding="{Binding DoseUnitCode}" Width="120"/>
                <DataGridTextColumn Header="دفعات روزانه" Binding="{Binding DailyFrequency}" Width="120"/>
                <DataGridTextColumn Header="شروع" Binding="{Binding StartedAt, StringFormat={}{0:yyyy/MM/dd}}" Width="130"/>
                <DataGridTextColumn Header="پایان" Binding="{Binding EndedAt, StringFormat={}{0:yyyy/MM/dd}}" Width="130"/>
                <DataGridTextColumn Header="نتیجه" Binding="{Binding ResultCode}" Width="120"/>
                <DataGridTextColumn Header="توضیحات" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
