<UserControl x:Class="SheepMonitor.App.Views.GrowthReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="گزارش رشد گوسفند" FontSize="28" FontWeight="Bold" Margin="0,0,0,18"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
            <ComboBox ItemsSource="{Binding Sheep}" SelectedItem="{Binding SelectedSheep}" DisplayMemberPath="Number" Width="220"/>
            <Button Content="نمایش گزارش" Margin="12,0,0,0" Padding="16,6" Click="Report_Click"/>
        </StackPanel>
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,18">
            <TextBlock Text="وزن اولیه" FontWeight="Bold"/>
            <TextBlock Text="{Binding Report.InitialWeightKg}"/>
            <TextBlock Text="آخرین وزن" FontWeight="Bold"/>
            <TextBlock Text="{Binding Report.LatestWeightKg}"/>
            <TextBlock Text="افزایش/کاهش کل" FontWeight="Bold"/>
            <TextBlock Text="{Binding Report.TotalWeightChangeKg}"/>
            <TextBlock Text="میانگین تغییر" FontWeight="Bold"/>
            <TextBlock Text="{Binding Report.AverageWeightChangeKg}"/>
        </UniformGrid>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Report.Points}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="180"/>
                <DataGridTextColumn Header="وزن (کیلوگرم)" Binding="{Binding WeightKg}" Width="180"/>
                <DataGridTextColumn Header="تغییر نسبت به وزن قبلی" Binding="{Binding ChangeFromPreviousKg}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
